# Supabase environment (required)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Brand identity (required for multi-tenant deployments)
# Set VITE_BRAND to the brand id (e.g. "gt" or "ecva")
# Assets are served from public/brands/<VITE_BRAND>/
VITE_BRAND=gt
VITE_APP_NAME="GT Beach Volleyball"
# Optional: path to a separate wordmark/text-banner image shown beneath the logo.
# Leave unset for brands whose logo already includes the name (e.g. ECVA).
VITE_BRAND_WORDMARK=/brands/gt/wordmark.png

# App metadata (optional)
VITE_SITE_URL="http://localhost:5173"
VITE_ENABLE_REALTIME="true"

# Notes:
# - Copy this file to ".env" for local development:
#     cp .env.example .env
# - Each Vercel deployment gets its own set of env vars.
#   See .env.gt.example and .env.ecva.example for per-brand configs.
