# GT Beach Volleyball — Vercel deployment config
# Copy to .env (or paste into Vercel Environment Variables)

# Supabase (fill in your project values)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Brand
VITE_BRAND=gt
VITE_BRAND_WORDMARK=/brands/gt/wordmark.png
VITE_APP_NAME="GT Beach Volleyball"

# App
VITE_SITE_URL=https://your-gt-deployment.vercel.app
VITE_ENABLE_REALTIME=true
