# ECVA Beach — Vercel deployment config
# Copy to .env (or paste into Vercel Environment Variables)

# Supabase (fill in your project values)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Brand
VITE_BRAND=ecva
VITE_APP_NAME="ECVA Beach"

# App
VITE_SITE_URL=https://your-ecva-deployment.vercel.app
VITE_ENABLE_REALTIME=true
